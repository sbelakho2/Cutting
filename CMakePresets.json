{
  "version": 6,
  "configurePresets": [
    {
      "name": "starz-base",
      "hidden": true,
      "generator": "Ninja",
      "environment": {
        "CC": "$penv{CC}",
        "CXX": "$penv{CXX}"
      }
    },
    {
      "name": "desktop",
      "inherits": "starz-base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {
      "name": "core",
      "inherits": "starz-base",
      "binaryDir": "${sourceDir}/build-core",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "STARZ_BUILD_HMI": "OFF", "STARZ_BUILD_ENGINEERING": "OFF"}
    },
    {
      "name": "sanitize",
      "inherits": "core",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {"STARZ_SANITIZE": "ON"}
    },
    {
      "name": "engineering",
      "inherits": "core",
      "binaryDir": "${sourceDir}/build-engineering",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "STARZ_BUILD_ENGINEERING": "ON"}
    },
    {
      "name": "engineering-sanitize",
      "inherits": "engineering",
      "binaryDir": "${sourceDir}/build-engineering-sanitize",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "STARZ_SANITIZE": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "desktop", "configurePreset": "desktop"},
    {"name": "core", "configurePreset": "core"},
    {"name": "sanitize", "configurePreset": "sanitize"},
    {"name": "engineering", "configurePreset": "engineering"},
    {"name": "engineering-sanitize", "configurePreset": "engineering-sanitize"}
  ],
  "testPresets": [
    {"name": "desktop", "configurePreset": "desktop", "output": {"outputOnFailure": true}},
    {"name": "core", "configurePreset": "core", "output": {"outputOnFailure": true}},
    {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}},
    {"name": "engineering", "configurePreset": "engineering", "output": {"outputOnFailure": true}},
    {"name": "engineering-sanitize", "configurePreset": "engineering-sanitize", "output": {"outputOnFailure": true}}
  ]
}
