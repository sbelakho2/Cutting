if(NOT DEFINED ANALYSIS_EXE OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "Missing shaft-analysis test paths")
endif()
execute_process(COMMAND "${ANALYSIS_EXE}" --report "${OUTPUT_DIR}" --meshes 2.0:0.30 --phases 8 --require-converged
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 900)
if(NOT result STREQUAL "2")
  message(FATAL_ERROR "Single-mesh shaft study did not fail the convergence gate: ${result}\n${output}\n${errors}")
endif()
file(READ "${OUTPUT_DIR}/status.json" record)
string(JSON complete GET "${record}" run_complete)
string(JSON released GET "${record}" fabrication_released)
string(JSON converged GET "${record}" numerical_gates_passed)
string(JSON failed GET "${record}" failed_gates)
if(NOT complete OR released OR converged OR failed LESS 1)
  message(FATAL_ERROR "Single-mesh shaft study has an unsafe success status: ${record}")
endif()