# Finishing-card CLI gate: templates are blank and unrunnable; synthetic records run.
if(NOT DEFINED CARDS_EXE OR NOT DEFINED OUTPUT_DIR OR NOT DEFINED FIXTURES)
  message(FATAL_ERROR "CARDS_EXE, OUTPUT_DIR and FIXTURES required")
endif()
file(REMOVE_RECURSE "${OUTPUT_DIR}")
execute_process(COMMAND "${CARDS_EXE}" --template "${OUTPUT_DIR}/templates" RESULT_VARIABLE r)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "Template generation failed")
endif()
file(READ "${OUTPUT_DIR}/templates/seat-records-template.csv" seats)
string(FIND "${seats}" ",S22.5-30.5_d12,12,,,,," idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "Seat template is not blank")
endif()
execute_process(COMMAND "${CARDS_EXE}" --seats "${OUTPUT_DIR}/templates/seat-records-template.csv"
  --bores "${OUTPUT_DIR}/templates/bore-records-template.csv" --out "${OUTPUT_DIR}/from-template" RESULT_VARIABLE r)
if(NOT r EQUAL 1)
  message(FATAL_ERROR "Blank template must be rejected with exit 1, got ${r}")
endif()
file(READ "${OUTPUT_DIR}/from-template/status.json" st)
string(FIND "${st}" "\"run_complete\":false" idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "Rejected run must leave run_complete false")
endif()
execute_process(COMMAND "${CARDS_EXE}" --seats "${FIXTURES}/synthetic-seat-records.csv"
  --bores "${FIXTURES}/synthetic-bore-records.csv" --out "${OUTPUT_DIR}/synthetic" RESULT_VARIABLE r OUTPUT_VARIABLE o)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "Synthetic finishing run failed: ${o}")
endif()
file(READ "${OUTPUT_DIR}/synthetic/grind-cards.csv" cards)
string(FIND "${cards}" "SYN-SHAFT-1,S22.5-30.5_d12,SYN-6001-A,11.9960000,12.2500000,12.3500000,12.0005000,11.9990000,12.0020000,11.9995000,12.0015000,16,6,5,2,4.000,5.000" idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "Grind card row mismatch:\n${cards}")
endif()
file(READ "${OUTPUT_DIR}/synthetic/status.json" st)
string(FIND "${st}" "\"physical_results\":false" idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "Status must declare no physical results")
endif()
# A coarse gauge record must fail closed with exit 1 (invalid argument).
execute_process(COMMAND "${CARDS_EXE}" --seats "${FIXTURES}/synthetic-seat-records-coarse-gauge.csv"
  --bores "${FIXTURES}/synthetic-bore-records.csv" --out "${OUTPUT_DIR}/coarse" RESULT_VARIABLE r)
if(NOT r EQUAL 1)
  message(FATAL_ERROR "Coarse gauge must exit 1, got ${r}")
endif()
message(STATUS "finishing CLI gate passed")
