if(NOT DEFINED ANALYSIS_EXE OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "ANALYSIS_EXE and OUTPUT_DIR required")
endif()
function(reject label diagnostic)
  execute_process(COMMAND "${ANALYSIS_EXE}" --report "${OUTPUT_DIR}/${label}" ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${rc}" STREQUAL "1" OR NOT error MATCHES "${diagnostic}")
    message(FATAL_ERROR "${label}: expected validation exit1/${diagnostic}; got ${rc}: ${output}${error}")
  endif()
  if(EXISTS "${OUTPUT_DIR}/${label}/status.json")
    message(FATAL_ERROR "${label}: invalid request must not initialise an engineering report")
  endif()
endfunction()
reject(unknown_part "FEM part must be" --fem-part invented)
reject(ascending "strictly decreasing" --fem-part adapter --fem-mesh-sizes 2,3)
reject(repeated "strictly decreasing" --fem-part adapter --fem-mesh-sizes 2,2)
reject(nonfinite "finite" --fem-part adapter --fem-mesh-sizes 2,nan)
reject(junk_suffix "finite" --fem-part adapter --fem-mesh-sizes 2,1mm)
reject(single_size "Specify2–8" --fem-part adapter --fem-mesh-sizes 2)
reject(trailing_empty "Empty FEM" --fem-part adapter --fem-mesh-sizes 2,1,)
reject(interior_empty "Empty FEM" --fem-part adapter --fem-mesh-sizes 2,,1)
reject(all_parts_override "one explicit" --fem --fem-mesh-sizes 2,1)
reject(without_fem "one explicit" --fem-mesh-sizes 2,1)
message(STATUS "10 invalid FEM requests rejected before report creation")