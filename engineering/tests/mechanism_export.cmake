if(NOT DEFINED CAD_EXE OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "CAD_EXE and OUTPUT_DIR are required")
endif()
if(NOT EXISTS "${CAD_EXE}")
  message(FATAL_ERROR "Mechanism CAD executable is missing: ${CAD_EXE}")
endif()

file(REMOVE_RECURSE "${OUTPUT_DIR}")
execute_process(
  COMMAND "${CAD_EXE}" --check --wire-od 4.5 --out "${OUTPUT_DIR}"
  RESULT_VARIABLE result
  OUTPUT_VARIABLE output
  ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Mechanism export failed (${result}):\n${output}\n${error}")
endif()

foreach(artifact IN ITEMS manifest.csv mechanism-bom.csv full-machine.step status.json)
  if(NOT EXISTS "${OUTPUT_DIR}/${artifact}")
    message(FATAL_ERROR "Mechanism export omitted ${artifact}")
  endif()
  file(SIZE "${OUTPUT_DIR}/${artifact}" artifact_size)
  if(artifact_size EQUAL 0)
    message(FATAL_ERROR "Mechanism export wrote an empty ${artifact}")
  endif()
endforeach()

file(READ "${OUTPUT_DIR}/manifest.csv" manifest_text)
string(REGEX MATCHALL "\n" manifest_newlines "${manifest_text}")
list(LENGTH manifest_newlines manifest_line_count)
if(NOT manifest_line_count EQUAL 505)
  message(FATAL_ERROR "Expected a header plus 504 mechanism occurrences, got ${manifest_line_count} manifest lines")
endif()
foreach(part_id IN ITEMS GD_G101 GD_G102 GD_G103 GD_G104 GD_G105 GD_G106 GD_G107 GD_G108 PO_P001 PO_P002 PO_P003 PO_P004 PO_P005 PO_P006 PO_P007)
  string(REGEX MATCHALL "\n${part_id}," part_rows "\n${manifest_text}")
  list(LENGTH part_rows part_row_count)
  if(NOT part_row_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one ${part_id} manifest occurrence, got ${part_row_count}")
  endif()
endforeach()

file(READ "${OUTPUT_DIR}/mechanism-bom.csv" mechanism_bom)
function(expect_bom_row required_bom_text)
  string(FIND "${mechanism_bom}" "${required_bom_text}" text_offset)
  if(text_offset EQUAL -1)
    message(FATAL_ERROR "Mechanism BOM omitted or changed required R3 entry: ${required_bom_text}")
  endif()
endfunction()
expect_bom_row([=["R2 selected DC01 2mm powder-coated left guard panel;30mm wire pass-through;not a safety-gap design",1,0]=])
expect_bom_row([=["R2 selected DC01 2mm powder-coated right guard panel;30mm wire pass-through;not a safety-gap design",1,0]=])
