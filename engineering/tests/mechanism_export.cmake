expect_bom_row([=["Bernstein SLC-F-024-20/20-R4 30x192x44 catalogue envelope;static fit only",1,1]=])
expect_bom_row([=["Bernstein ACF-1 60x40x52.6 catalogue envelope;static fit only",1,1]=])
expect_bom_row([=["R2 selected welded payoff spool OD400x160;3mm S235JR flanges with 20.5 bores;60x2.5 ERW hub;not load-qualified",1,0]=])
