file(READ "${OUTPUT_DIR}/status.json" mechanism_status)
string(JSON status_type ERROR_VARIABLE json_error TYPE "${mechanism_status}")
if(NOT json_error STREQUAL "NOTFOUND" OR NOT status_type STREQUAL "OBJECT")
  message(FATAL_ERROR "Mechanism status.json is not a JSON object: ${json_error}")
endif()
function(expect_status key expected_value)
  string(JSON actual_value ERROR_VARIABLE status_error GET "${mechanism_status}" "${key}")
  if(NOT status_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "status.json cannot read ${key}: ${status_error}")
  endif()
  if(NOT actual_value STREQUAL "${expected_value}")
    message(FATAL_ERROR "status.json records ${key}:${actual_value}, expected ${expected_value}")
  endif()
endfunction()

expect_status(mechanism_revision "S1-B-MECH-R4-2026-09-16")
expect_status(run_complete ON)
expect_status(occurrences 504)
expect_status(cross_subsystem_static_intersections_checked ON)
expect_status(external_wire_route_checked ON)
expect_status(step_readback ON)
expect_status(frame_integrated ON)
expect_status(guard_door_kinematics_validated OFF)
expect_status(guard_safety_function_validated OFF)
expect_status(payoff_selection_complete OFF)
expect_status(payoff_rotation_validated OFF)
expect_status(full_machine_integrated OFF)
expect_status(physical_results OFF)
expect_status(fabrication_released OFF)

string(FIND "${mechanism_status}" "R2 guard/payoff selections" scope_offset)
if(scope_offset EQUAL -1)
  message(FATAL_ERROR "status.json does not retain the R2 guard/payoff scope")
endif()
message(STATUS "Mechanism R4 export verified: 504 occurrences, STEP readback, R2 guard/payoff scope and unreleased gates")
