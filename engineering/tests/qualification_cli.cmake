# Qualification CLI gate: blank templates are rejected; synthetic records evaluate.
if(NOT DEFINED QUAL_EXE OR NOT DEFINED OUTPUT_DIR OR NOT DEFINED FIXTURES)
  message(FATAL_ERROR "QUAL_EXE, OUTPUT_DIR and FIXTURES required")
endif()
file(REMOVE_RECURSE "${OUTPUT_DIR}")
execute_process(COMMAND "${QUAL_EXE}" --template "${OUTPUT_DIR}/templates" RESULT_VARIABLE r)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "Template generation failed")
endif()
file(READ "${OUTPUT_DIR}/templates/length-records-template.csv" lengths)
string(FIND "${lengths}" ",1.2,200,,,," idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "Length template is not blank")
endif()
execute_process(COMMAND "${QUAL_EXE}" --lengths "${OUTPUT_DIR}/templates/length-records-template.csv"
  --forces "${OUTPUT_DIR}/templates/force-records-template.csv" --out "${OUTPUT_DIR}/from-template" RESULT_VARIABLE r)
if(NOT r EQUAL 1)
  message(FATAL_ERROR "Blank template must be rejected with exit 1, got ${r}")
endif()
file(READ "${OUTPUT_DIR}/from-template/status.json" st)
string(FIND "${st}" "\"run_complete\":false" idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "Rejected run must leave run_complete false")
endif()
execute_process(COMMAND "${QUAL_EXE}" --lengths "${FIXTURES}/synthetic-length-records.csv"
  --forces "${FIXTURES}/synthetic-force-records.csv" --out "${OUTPUT_DIR}/synthetic" RESULT_VARIABLE r OUTPUT_VARIABLE o)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "Synthetic qualification run failed: ${o}")
endif()
file(READ "${OUTPUT_DIR}/synthetic/status.json" st)
string(FIND "${st}" "\"qualification_passed\":true" idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "Synthetic capable set must pass")
endif()
string(FIND "${st}" "\"physical_results\":false" idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "SYN- records must never be reported as physical results")
endif()
file(READ "${OUTPUT_DIR}/synthetic/report.md" rep)
string(FIND "${rep}" "SYN- identities present" idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "Report must flag synthetic identities")
endif()
# A single out-of-window force must fail the whole qualification with exit 3.
file(READ "${FIXTURES}/synthetic-force-records.csv" forces)
string(REPLACE "WHEEL,4.5,10.2" "WHEEL,4.5,4.0" forces "${forces}")
file(WRITE "${OUTPUT_DIR}/weak-wheel.csv" "${forces}")
execute_process(COMMAND "${QUAL_EXE}" --lengths "${FIXTURES}/synthetic-length-records.csv"
  --forces "${OUTPUT_DIR}/weak-wheel.csv" --out "${OUTPUT_DIR}/weak" RESULT_VARIABLE r)
if(NOT r EQUAL 3)
  message(FATAL_ERROR "Weak wheel force must fail with exit 3, got ${r}")
endif()
file(READ "${OUTPUT_DIR}/weak/status.json" st)
string(FIND "${st}" "\"qualification_passed\":false" idx)
if(idx EQUAL -1)
  message(FATAL_ERROR "Failed qualification must report qualification_passed false")
endif()
