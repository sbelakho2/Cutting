if(NOT DEFINED PROBE_EXE OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "Missing boundary topology test paths")
endif()
# Recreate the historical full-shaft mesh; do not substitute a favorable cell,
# a smaller cut-out, a changed sizing field or a relaxed node/volume limit.
foreach(method IN ITEMS baseline netgen)
  execute_process(COMMAND "${PROBE_EXE}" "${OUTPUT_DIR}/${method}" "${method}" 0.85 0.009375
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 1000)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Boundary ${method} experiment failed: ${result}\n${output}\n${errors}")
  endif()
  message(STATUS "${output}")
  file(READ "${OUTPUT_DIR}/${method}/status.json" record)
  string(JSON complete GET "${record}" run_complete)
  string(JSON released GET "${record}" fabrication_released)
  string(JSON continuous GET "${record}" continuous_containment_verified)
  string(JSON stress GET "${record}" stress_verified)
  if(NOT complete OR released OR continuous OR stress)
    message(FATAL_ERROR "Incorrect boundary probe completion/scope: ${record}")
  endif()
  foreach(key IN ITEMS nodes tets same_surface_tets exterior_centroid_tets A12_same_surface_tets A12_exterior_centroid_tets node_limit min_SICN)
    string(JSON ${method}_${key} GET "${record}" "${key}")
  endforeach()
  if(${method}_nodes GREATER 150000 OR NOT ${method}_node_limit EQUAL 150000)
    message(FATAL_ERROR "Boundary test exceeded or changed node cap")
  endif()
  file(STRINGS "${OUTPUT_DIR}/${method}/same-surface-cells.csv" rows)
  list(LENGTH rows count)
  math(EXPR expected "${${method}_same_surface_tets}+1")
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "Boundary cell table/status counts disagree")
  endif()
endforeach()
if(NOT baseline_nodes EQUAL 136805 OR NOT baseline_tets EQUAL 568908 OR
   NOT baseline_same_surface_tets EQUAL 142 OR NOT baseline_exterior_centroid_tets EQUAL 130 OR
   NOT baseline_A12_same_surface_tets EQUAL 9 OR NOT baseline_A12_exterior_centroid_tets EQUAL 9)
  message(FATAL_ERROR "Baseline does not reproduce the pinned Gmsh/OCC historical discrepancy")
endif()
file(READ "${OUTPUT_DIR}/baseline/same-surface-cells.csv" baseline_cells)
if(NOT baseline_cells MATCHES "\n489924,[^\n]+,outside\n")
  message(FATAL_ERROR "Historical peak cell was omitted from baseline audit")
endif()
if(NOT netgen_same_surface_tets EQUAL 0 OR NOT netgen_exterior_centroid_tets EQUAL 0 OR
   NOT netgen_A12_same_surface_tets EQUAL 0 OR NOT netgen_A12_exterior_centroid_tets EQUAL 0 OR
   NOT netgen_min_SICN GREATER baseline_min_SICN)
  message(FATAL_ERROR "Netgen did not eliminate the reproduced same-surface-cell pathology")
endif()
# The optional torus-focus list must fail closed on unknown features, empty
# names and unknown options before any mesh is generated.
foreach(bad IN ITEMS "unknown_feature" "A12_S19_62,,pulley_key_floor" "")
  execute_process(COMMAND "${PROBE_EXE}" "${OUTPUT_DIR}/rejected" netgen 0.85 0.009375 --focus "${bad}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
  if(result STREQUAL "0")
    message(FATAL_ERROR "Probe accepted invalid focus list '${bad}'")
  endif()
endforeach()
execute_process(COMMAND "${PROBE_EXE}" "${OUTPUT_DIR}/rejected" netgen 0.85 0.009375 --focus-feature pulley_key_floor
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
if(result STREQUAL "0")
  message(FATAL_ERROR "Probe accepted an unknown option")
endif()
file(READ "${OUTPUT_DIR}/netgen/status.json" record)
string(JSON focus GET "${record}" focus_features)
if(NOT focus STREQUAL "A12_S19_62")
  message(FATAL_ERROR "Default probe focus changed: ${focus}")
endif()
message(STATUS "Exact full-shaft boundary topology regression passed; not continuous containment or stress qualification")