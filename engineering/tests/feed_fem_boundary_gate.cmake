if(NOT DEFINED ANALYSIS_EXE OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "Missing boundary stress test paths")
endif()
execute_process(COMMAND "${ANALYSIS_EXE}" --report "${OUTPUT_DIR}"
  --focus-region A12_groove --focus-feature A12_S19_62 --background-root 0.20 --focus-growth 0.70
  --mesh-optimizer netgen --meshes 1.6:0.032 --phases 8 --require-converged
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 900)
if(NOT result STREQUAL "2")
  message(FATAL_ERROR "Boundary stress study did not complete and hold convergence: ${result}\n${output}\n${errors}")
endif()
file(READ "${OUTPUT_DIR}/status.json" record)
foreach(name IN ITEMS run_complete mesh_geometry_audit_passed)
  string(JSON value GET "${record}" "${name}")
  if(NOT value)
    message(FATAL_ERROR "Boundary stress study incomplete: ${record}")
  endif()
endforeach()
foreach(name IN ITEMS numerical_gates_passed continuous_CAD_containment_verified fabrication_released)
  string(JSON value GET "${record}" "${name}")
  if(value)
    message(FATAL_ERROR "Boundary stress study incorrectly certified ${name}: ${record}")
  endif()
endforeach()
string(JSON optimizer GET "${record}" mesh_optimizer)
string(JSON cap GET "${record}" node_limit)
string(JSON count GET "${record}" finest_same_surface_tets)
if(NOT optimizer STREQUAL "netgen" OR NOT cap EQUAL 150000 OR NOT count EQUAL 0)
  message(FATAL_ERROR "Optimizer/topology/node provenance incorrect: ${record}")
endif()
foreach(table IN ITEMS regions.csv peak-cad-states.csv)
  file(STRINGS "${OUTPUT_DIR}/${table}" rows)
  list(LENGTH rows count)
  if((table STREQUAL "regions.csv" AND NOT count EQUAL 21) OR
     (table STREQUAL "peak-cad-states.csv" AND NOT count EQUAL 41))
    message(FATAL_ERROR "Boundary study omitted a region, load class or raw/bound geometry check")
  endif()
endforeach()
file(READ "${OUTPUT_DIR}/criteria.csv" criteria)
foreach(name IN ITEMS no_exterior_same_surface_centroids all_reported_peak_centroids_in_CAD)
  if(NOT criteria MATCHES "${name},[0-9]+,0,(PASS_SCOPED|REFINE_OR_FAIL)")
    message(FATAL_ERROR "Missing zero-exterior geometry gate: ${name}")
  endif()
endforeach()
if(NOT criteria MATCHES "focused_study_requires_background_and_all_root_verification,0,1,REFINE_OR_FAIL")
  message(FATAL_ERROR "Mandatory focused scope hold missing")
endif()
# The same reporting path must detect, retain and gate the historical exterior
# raw/bound peaks. Merely checking the new CSV/header would miss a no-op audit.
execute_process(COMMAND "${ANALYSIS_EXE}" --report "${OUTPUT_DIR}/baseline"
  --focus-region A12_groove --focus-feature A12_S19_62 --background-root 0.20 --focus-growth 0.70
  --mesh-optimizer gmsh --meshes 0.85:0.009375 --phases 8 --require-converged
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 900)
if(NOT result STREQUAL "2")
  message(FATAL_ERROR "Historical exterior stress case was not completed/held: ${result}\n${output}\n${errors}")
endif()
file(READ "${OUTPUT_DIR}/baseline/status.json" baseline)
string(JSON outside GET "${baseline}" finest_exterior_same_surface_centroids)
string(JSON peaks GET "${baseline}" finest_exterior_peak_centroids)
if(NOT outside EQUAL 130 OR NOT peaks GREATER 0)
  message(FATAL_ERROR "Driver omitted known exterior cells or peaks")
endif()
file(READ "${OUTPUT_DIR}/baseline/criteria.csv" criteria)
if(NOT criteria MATCHES "no_exterior_same_surface_centroids,130,0,REFINE_OR_FAIL" OR
   NOT criteria MATCHES "all_reported_peak_centroids_in_CAD,[1-9][0-9]*,0,REFINE_OR_FAIL")
  message(FATAL_ERROR "Exterior CAD classifications did not cause zero-count gate failures")
endif()