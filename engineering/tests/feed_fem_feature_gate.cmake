if(NOT DEFINED ANALYSIS_EXE OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "Missing CAD feature-analysis test paths")
endif()
execute_process(COMMAND "${ANALYSIS_EXE}" --report "${OUTPUT_DIR}"
  --focus-region M15_relief --focus-feature M15_slot_exit --background-root 0.20 --focus-growth 0.55
  --meshes 1.6:0.128 --phases 8 --require-converged
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 900)
if(NOT result STREQUAL "2")
  message(FATAL_ERROR "CAD-feature single mesh did not complete and hold convergence: ${result}\n${output}\n${errors}")
endif()
file(READ "${OUTPUT_DIR}/status.json" record)
foreach(name IN ITEMS run_complete mesh_geometry_audit_passed)
  string(JSON value GET "${record}" "${name}")
  if(NOT value)
    message(FATAL_ERROR "Feature study did not complete ${name}: ${record}")
  endif()
endforeach()
foreach(name IN ITEMS numerical_gates_passed fabrication_released)
  string(JSON value GET "${record}" "${name}")
  if(value)
    message(FATAL_ERROR "Feature study incorrectly released ${name}: ${record}")
  endif()
endforeach()
string(JSON feature GET "${record}" mesh_focus_feature)
string(JSON face_count GET "${record}" sizing_face_count)
string(JSON focus GET "${record}" mesh_focus_region)
string(JSON field GET "${record}" field_governing_region)
if(NOT feature STREQUAL "M15_slot_exit" OR face_count LESS 1 OR NOT focus STREQUAL "M15_relief" OR NOT field STREQUAL "M15_relief")
  message(FATAL_ERROR "Feature/field provenance incorrect: ${record}")
endif()
file(STRINGS "${OUTPUT_DIR}/sizing-faces.csv" faces)
list(LENGTH faces count)
math(EXPR expected "${face_count}+1")
if(NOT count EQUAL expected)
  message(FATAL_ERROR "Selected CAD face count mismatch")
endif()
file(STRINGS "${OUTPUT_DIR}/regions.csv" regions)
list(LENGTH regions count)
if(NOT count EQUAL 21)
  message(FATAL_ERROR "Feature analysis omitted stress regions")
endif()
file(READ "${OUTPUT_DIR}/criteria.csv" criteria)
if(NOT criteria MATCHES "focused_study_requires_background_and_all_root_verification,0,1,REFINE_OR_FAIL")
  message(FATAL_ERROR "Mandatory focused scope hold missing")
endif()