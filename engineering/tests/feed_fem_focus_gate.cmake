if(NOT DEFINED ANALYSIS_EXE OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "Missing focused shaft-analysis test paths")
endif()
# This exact focused mesh previously triggered a false mixed-scale rank failure.
execute_process(COMMAND "${ANALYSIS_EXE}" --report "${OUTPUT_DIR}"
  --focus-region A12_groove --background-root 0.20 --focus-growth 0.70
  --meshes 1.0:0.02 --phases 8 --require-converged
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 900)
if(NOT result STREQUAL "2")
  message(FATAL_ERROR "Focused single mesh did not complete and hold convergence: ${result}\n${output}\n${errors}")
endif()
file(READ "${OUTPUT_DIR}/status.json" record)
foreach(name IN ITEMS run_complete mesh_geometry_audit_passed)
  string(JSON value GET "${record}" "${name}")
  if(NOT value)
    message(FATAL_ERROR "Focused study did not complete ${name}: ${record}")
  endif()
endforeach()
foreach(name IN ITEMS numerical_gates_passed fabrication_released)
  string(JSON value GET "${record}" "${name}")
  if(value)
    message(FATAL_ERROR "Single focused mesh incorrectly released ${name}: ${record}")
  endif()
endforeach()
string(JSON focus GET "${record}" mesh_focus_region)
string(JSON field GET "${record}" field_governing_region)
if(NOT focus STREQUAL "A12_groove" OR NOT field STREQUAL "A12_groove")
  message(FATAL_ERROR "Focus/field provenance incorrect: ${record}")
endif()
file(STRINGS "${OUTPUT_DIR}/regions.csv" regions)
list(LENGTH regions count)
if(NOT count EQUAL 21)
  message(FATAL_ERROR "Focused analysis omitted regional peak rows: ${count}")
endif()