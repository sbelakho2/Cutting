         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">EtherCAT - Der Ethernet-Feldbus</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>EtherCAT Technology Group (ETG)</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Mit dieser BroschÃ¼re mÃ¶chten wir Ihnen EtherCAT vorstellen, den Ethernet-Feldbus. Sie lernen die Technologie kennen und werden verstehen, weshalb EtherCAT als der schnellste Industrial-Ethernet-Standard gilt. Sie bekommen einen Einblick in die EtherCAT Technology Group, den weltweit mitgliederstÃ¤rksten Feldbusverband. Wir zeigen Ihnen, welche Vorteile EtherCAT fÃ¼r Ihre Aufgabenstellung hat.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>ETG</rdf:li>
               <rdf:li>EtherCAT</rdf:li>
               <rdf:li>Feldbus</rdf:li>
               <rdf:li>Technologie</rdf:li>
               <rdf:li>Safety</rdf:li>
               <rdf:li>FSoE</rdf:li>
               <rdf:li>EAP</rdf:li>
               <rdf:li>ESC</rdf:li>
               <rdf:li>KonformitÃ¤t</rdf:li>
               <rdf:li>Zertifizierung</rdf:li>
               <rdf:li>IEC</rdf:li>
               <rdf:li>ISO</rdf:li>
               <rdf:li>SEMI</rdf:li>
            </rdf:Bag>
         </dc:subject>
