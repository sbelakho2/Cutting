					(number "2")
					(value "Placed/routed draft PCB source; review and release gates remain open")
				)
				(comment
					(number "3")
					(value "C2/C3: 50 V minimum because TPL COM is connected to +24V_TPL_COM")
				)
				(comment
					(number "4")
					(value "J8/J9 RU3100: single-ended TTL via IO-Link; A-/B- at a 2.5 V mid-bias (10k/10k 1 %, 100 nF); R1-R4 120 ohm terminators removed")
				)
				(comment
					(number "5")
					(value "F1-F3: verified 1812 SMD PTCs MF-MSMF050/60X (24 V branch) and MF-MSMF050/16X (5 V encoder branches)")
